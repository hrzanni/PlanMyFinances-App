# Layout hoisted: recomendação oficial do Expo para monorepo (instalação isolada
# do pnpm quebra o autolinking nativo no EAS — import errado de ExpoModulesPackage)
node-linker=hoisted
# Peers resolvem para o que cada app fornece (evita árvore Expo/React duplicada)
auto-install-peers=false
strict-peer-dependencies=false
