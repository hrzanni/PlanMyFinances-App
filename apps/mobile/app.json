{
  "expo": {
    "name": "PlanMyFinances",
    "slug": "planmyfinances",
    "scheme": "planmyfinances",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["android", "ios"],
    "android": {
      "package": "br.com.planmyfinances.app",
      "adaptiveIcon": { "backgroundColor": "#0C0E0E" }
